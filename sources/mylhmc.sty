% ---------------------------------------------------------------------
% \myattach{file}{content}: attached file whose annotation is `content'.
% With \DocumentMetadata the file is embedded with the pdfmanagement
% (\pdffile_embed_file:nnn, /AFRelationship /Supplement as PDF/UA-2
% requires) and the annotation goes in an Annot structure; `content' is
% marked as artifact. Without \DocumentMetadata, attachfile2 is used.
% \setmylhmc{ attach-color = <color> } sets the color of `content'.
% ---------------------------------------------------------------------
\tl_new:N \l__mylhmc_attach_color_tl
\keys_define:nn { mylhmc }
  {
    attach-color .tl_set:N = \l__mylhmc_attach_color_tl ,
    attach-color .initial:n = black ,
  }
\IfDocumentMetadataTF
  {
    \box_new:N \l__mylhmc_attach_box
    \hook_gput_code:nnn { begindocument } { mylhmc }
      { \pdfxform_new:nnn { mylhmc/attach/emptyAP } { } { \hbox_to_wd:nn { 1sp } { } } }
    \cs_new_protected:Npn \__mylhmc_attach:nn #1#2
      {
        \pdf_object_if_exist:nF { mylhmc/attach/#1 }
          {
            \group_begin:
              \pdfdict_put:nnn { l_pdffile/Filespec } { AFRelationship } { /Supplement }
              \pdffile_embed_file:nnn {#1} {#1} { mylhmc/attach/#1 }
            \group_end:
          }
        \hbox_set:Nn \l__mylhmc_attach_box
          { \exp_args:NV \textcolor \l__mylhmc_attach_color_tl {#2} }
        \tag_struct_begin:n { tag = Annot , alt = { Archivo~adjunto~#1 } }
        \pdfannot_box:nnne
          { \box_wd:N \l__mylhmc_attach_box }
          { \box_ht:N \l__mylhmc_attach_box }
          { \box_dp:N \l__mylhmc_attach_box }
          {
            /Subtype /FileAttachment
            /FS ~ \pdf_object_ref:n { mylhmc/attach/#1 }
            /Contents ~ (Archivo~adjunto~#1)
            /AP ~ << /N ~ \pdfxform_ref:n { mylhmc/attach/emptyAP } >>
            \tag_if_active:T { /StructParent ~ \tag_struct_parent_int: }
          }
        \tag_if_active:T
          {
            \tag_struct_insert_annot:ee
              { \pdfannot_box_ref_last: } { \tag_struct_parent_int: }
          }
        \tag_struct_end:
        \tag_mc_end_push:
        \tag_mc_begin:n { artifact }
        \box_use_drop:N \l__mylhmc_attach_box
        \tag_mc_end:
        \tag_mc_begin_pop:n { }
      }
  }
  {
    \RequirePackage { attachfile2 }
    \cs_new_protected:Npn \__mylhmc_attach:nn #1#2
      {
        \use:e
          {
            \exp_not:N \textattachfile
              [ color = \exp_not:V \l__mylhmc_attach_color_tl , print = false ]
              { \exp_not:n {#1} } { \exp_not:n {#2} }
          }
      }
  }
\NewDocumentCommand \myattach { m m }
  { \__mylhmc_attach:nn {#1} {#2} }

