\NewDocumentCommand \myoarg { O{} m }
  { \__mylhmc_meta_generic:Nnn \__mylhmc_oarg:n { #1 } { #2 } }
\NewDocumentCommand \myparg { O{} m }
  { \__mylhmc_meta_generic:Nnn \__mylhmc_parg:n { #1 } { #2 } }
