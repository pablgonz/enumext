\NewDocumentCommand \myhlc { v }
  {
    \mode_leave_vertical:
    \group_begin:
      \ttfamily
      \__mylhmc_luafun_inline:n {#1}
    \group_end:
  }
\cs_new_protected:Npn \__mylhmc_luafun_inline:n #1
  {
    \tl_set:Nn \l__mylhmc_verbatim_line_tl {#1}
    \__mylhmc_luafun_inline:
  }

\hook_gput_code:nnn { begindocument } { mylhmc }
  {
    % Fuente de los números de línea: se resuelve UNA vez. \ttfamily\tiny en
    % cada línea costaba más que todo el coloreado en Lua.
    \group_begin:
      \ttfamily \tiny
      \exp_last_unbraced:NNNo \tex_global:D \tex_let:D
        \__mylhmc_lineno_font: { \tex_the:D \tex_font:D }
    \group_end:
    \renewcommand \theCodelineNo
      {
        \__mylhmc_luafun_actual_text_begin:
        \group_begin:
          \color_select:n { mylhmc / guard / angle }
          \__mylhmc_lineno_font: \arabic { CodelineNo }
        \group_end:
        \__mylhmc_luafun_actual_text_end:
      }
  }

\group_begin:
  \int_set:Nn \tex_endlinechar:D { -1 }
  \use:n
    {
      \char_set_catcode_active:n { 32 }
      \tl_const:Nn \c__mylhmc_active_space_tl
    }{ }
\group_end:

\tl_new:N \l__mylhmc_verbatim_line_tl
\tl_new:N \l__mylhmc_verbatim_finish_tl

\group_begin:
  \char_set_catcode_active:n { 13 }
  \cs_new_protected:Npe \__mylhmc_set_end_pattern:n #1
    {
      \tl_set:Nn \exp_not:N \l__mylhmc_verbatim_finish_tl
        {
          \c_percent_str
          \prg_replicate:nn { 4 } { \exp_not:o { \c__mylhmc_active_space_tl } }
          \exp_not:o { \active@escape@char } end
          \c_left_brace_str #1 \c_right_brace_str
          \exp_not:N ^^M
        }
    }
  \cs_new_protected:Npn \__mylhmc_verbatim_start:w #1
    {
      \str_if_eq:nnTF { #1 } { ^^M }
        { \__mylhmc_verbatim_read_line:w }
        { \__mylhmc_verbatim_read_line:w #1 }
    }
  \cs_new_protected:Npn \__mylhmc_verbatim_read_line:w #1 ^^M
    {
      \tl_set:Nn \l__mylhmc_verbatim_line_tl { #1 ^^M }
      \tl_if_eq:NNTF \l__mylhmc_verbatim_line_tl \l__mylhmc_verbatim_finish_tl
        { \exp_args:Ne \end { \@currenvir } }
        {
          \__mylhmc_output_line:
          \__mylhmc_verbatim_read_line:w
        }
    }
\group_end:

\cs_new_protected_nopar:Nn \__mylhmc_output_line:
  {
    \tex_noindent:D
    \__mylhmc_luafun_process_line:
    % \par de LaTeX (no la primitiva): dispara el hook de fin de párrafo;
    % con tagging, \tex_par:D dejaba cada línea como un párrafo sin cerrar.
    \par
  }

\cs_generate_variant:Nn \__mylhmc_set_end_pattern:n { V }
\cs_set_protected_nopar:Npn \xmacro@code
  {
    \__mylhmc_set_end_pattern:V \@currenvir
    \__mylhmc_verbatim_start:w
  }
\cs_set_eq:cN { xmacro@code* } \xmacro@code

\msg_new:nnnn { mylhmc } { invalid-hex-color }
  { Invalid~color~value~'#2'~for~key~'#1':~expected~6~hex~digits~(e.g.~FF0000). }
  { The~color~was~not~changed~and~keeps~its~previous~value. }
\msg_new:nnnn { mylhmc } { unknown-key }
  { Unknown~mylhmc~key~'#1'. }
  { Check~the~color~name~(use~its~full~path,~e.g.~guard/star)~or~use~
    provide~to~register~module~commands. }

\keys_define:nn { mylhmc }
  {
    unknown .code:n =
      { \msg_error:nne { mylhmc } { unknown-key } { \l_keys_key_str } } ,
    provide .code:n =
      { \clist_map_function:nN {#1} \__mylhmc_luafun_register_module_cmd:n } ,
    provide .value_required:n = true ,
    % Segmentos de ruta de claves del módulo (key-path=print): segmentos de ruta como
    % `enumext / print` en \keys_define:nn/\keys_set:nn que se colorean
    % como module_name aunque no sean un comando de `provide`.
    key-path .code:n =
      { \clist_map_function:nN {#1} \__mylhmc_luafun_register_key_path:n } ,
    key-path .value_required:n = true ,
    % Respaldo de nombre de módulo para \myhlc antes de la primera
    % guarda %<@@=modulo> real -- vive solo del lado de Lua, nunca toca
    % \g__codedoc_module_name_tl (variable global de l3doc.cls).
    module .code:n =
      { \__mylhmc_luafun_set_module_backup:n {#1} } ,
    module .value_required:n = true ,
    % Fallback de itálica para comentarios: true (por defecto) = siempre
    % Latin Modern Mono Italic; false = busca primero una itálica
    % hermana de la fuente actual (como ya hace la negrita), cayendo a
    % Latin Modern solo si no encuentra ninguna.
    lmmono .code:n =
      { \__mylhmc_luafun_set_lmmono:n {#1} } ,
    lmmono .value_required:n = true ,
    % Palabra clave de prioridad extra para la negrita (p.ej.
    % bold=Semibold): si coincide con una fuente hermana cargada, gana
    % por encima de medium/semibold/bold; si no coincide con ninguna
    % (o nunca se fija), cae al comportamiento actual sin cambios.
    bold .code:n =
      { \__mylhmc_luafun_set_bold_weight:n {#1} } ,
    bold .value_required:n = true ,
  }

\cs_new_protected:Npn \__mylhmc_define_color_key:nnn #1#2#3
  {
    \keys_define:nn { mylhmc }
      {
        #1 .code:n =
          {
            \regex_match:nnTF { ^ [0-9A-Fa-f] {6} $ } {##1}
              { \__mylhmc_define_color:nnn { #1 } { HTML } {##1} }
              { \msg_error:nnnn { mylhmc } { invalid-hex-color } { #1 } {##1} }
          } ,
        #1 .value_required:n = true ,
      }
  }
\seq_map_inline:Nn \g__mylhmc_colors_export_seq
  { \__mylhmc_define_color_key:nnn #1 }

\NewDocumentCommand \setmylhmc { m }
  { \keys_set:nn { mylhmc } { #1 } }

% ---------------------------------------------------------------------
% Tagging support for l3doc (only with \DocumentMetadata).
% Loads the latex-lab l3doc support and maps its structures to standard
% PDF structure types (its own function/macro/... types are unknown to the
% LaTeX RelaxNG schemas). A later \AssignStructureRole overrides any of them.
% ---------------------------------------------------------------------
\IfDocumentMetadataT
  {
    \RequirePackage { latex-lab-testphase-l3doc }
    \AssignStructureRole { doc/function              } { Sect    }
    \AssignStructureRole { doc/functionnames         } { Caption }
    \AssignStructureRole { doc/functionname          } { Code    }
    \AssignStructureRole { doc/functionnamepart      } { Span    }
    \AssignStructureRole { doc/syntax                } { Div     }
    \AssignStructureRole { doc/function-description  } { Div     }
    \AssignStructureRole { doc/macro                 } { Sect    }
    \AssignStructureRole { doc/macronames            } { Caption }
    \AssignStructureRole { doc/macroname             } { Code    }
    \AssignStructureRole { doc/variable              } { Sect    }
    \AssignStructureRole { doc/variablenames         } { Caption }
    \AssignStructureRole { doc/variablename          } { Code    }
    \AssignStructureRole { doc/codelinenum           } { Lbl     }
    % The macro environment of latex-lab-testphase-l3doc hard-codes the tag
    % name `macro'; use the (re)assigned role instead.
    \cs_if_exist:NT \__codedoc_macro_dump:
      {
        \cs_set_protected:Npn \__codedoc_macro_dump:
          {
            \int_compare:nNnF { \l__codedoc_nested_macro_int } > { 1 }
              {
                \begin{displayblock}
                  [ tag-name = \UseStructureName{doc/macro} , begin-vspace = \MacroTopsep ]
                \UseTaggingSocket{doc/container/macronames}{\l__codedoc_current_names_struct_tl}
              }
            \noindent \llap
              {
                \tagmcend
                \hbox_unpack_drop:N \l__codedoc_macro_index_box
                \vtop to \baselineskip
                  {
                    \vbox_unpack_drop:N \l__codedoc_macro_box
                    \vss
                  }
                \hspace{\labelsep}
                \tagmcbegin{}
              }
          }
      }
  }

% ---------------------------------------------------------------------
% Short verbatim: \setmylhmc{ shortverb = \| , shortverb-options = {...} }
% removes the l3doc short verbs \" and the given one, and defines the
% latter again with listings (\lstMakeShortInline).
% ---------------------------------------------------------------------
\tl_new:N \l__mylhmc_shortverb_tl
\tl_new:N \l__mylhmc_shortverb_options_tl
\keys_define:nn { mylhmc }
  {
    shortverb         .tl_set:N = \l__mylhmc_shortverb_tl ,
    shortverb-options .tl_set:N = \l__mylhmc_shortverb_options_tl ,
    shortverb-options .initial:n = { basicstyle = \ttfamily } ,
  }
\cs_new_protected:Npn \__mylhmc_shortverb_make:nn #1 #2
  { \lstMakeShortInline [ #1 ] #2 }
\cs_generate_variant:Nn \__mylhmc_shortverb_make:nn { VV }
\cs_new_protected:Npn \__mylhmc_shortverb_setup:
  {
    \tl_if_empty:NF \l__mylhmc_shortverb_tl
      {
        \DeleteShortVerb \"
        \exp_last_unbraced:NV \DeleteShortVerb \l__mylhmc_shortverb_tl
        \__mylhmc_shortverb_make:VV
          \l__mylhmc_shortverb_options_tl \l__mylhmc_shortverb_tl
      }
  }
\hook_gput_code:nnn { begindocument } { mylhmc } { \__mylhmc_shortverb_setup: }

% ---------------------------------------------------------------------
% Coloured \meta, \marg, \oarg and (p)arg:
%   \mymeta[opts]{x}  <x>      \mymarg[opts]{x}  {<x>}
%   \myoarg[opts]{x}  [<x>]    \myparg[opts]{x}  (<x>)
% opts (module mylhmc/meta): type=tt|rm, cf (text), ac (angles),
% sbc (brackets), cbc (braces), pbc (parentheses).
% \setmylhmc{ meta/angle-font = <font switches> } sets the font of the
% angle brackets.
% ---------------------------------------------------------------------
\tl_new:N \l__mylhmc_meta_font_tl
\tl_new:N \l__mylhmc_meta_anglefont_tl
\keys_define:nn { mylhmc / meta }
  {
    type .choice:,
    type / tt .code:n = \tl_set:Nn \l__mylhmc_meta_font_tl { \ttfamily },
    type / rm .code:n = \tl_set:Nn \l__mylhmc_meta_font_tl { \rmfamily },
    type .initial:n = tt,
    cf   .tl_set:N = \l__mylhmc_meta_color_tl,
    cf   .initial:n = keyname,
    ac   .tl_set:N = \l__mylhmc_meta_anglecolor_tl,
    ac   .initial:n = lightgray,
    sbc  .tl_set:N = \l__mylhmc_meta_brackcolor_tl,
    sbc  .initial:n = gray,
    cbc  .tl_set:N = \l__mylhmc_meta_bracecolor_tl,
    cbc  .initial:n = gray,
    pbc  .tl_set:N = \l__mylhmc_meta_parencolor_tl,
    pbc  .initial:n = gray,
    angle-font .code:n =
      { \tl_trim_spaces_apply:nN {#1} \__mylhmc_meta_set_anglefont:n },
  }
\cs_new_protected:Npn \__mylhmc_meta_set_anglefont:n #1
  { \tl_set:Nn \l__mylhmc_meta_anglefont_tl {#1} }
\NewDocumentCommand \mymeta { O{} m }
