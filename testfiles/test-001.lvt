% test-001.lvt -- listas y numeracion de enumext (sin etiquetado)
%
% Hecho con cariño por Pablo González L. <pablgonz@educarchile.cl>
% para que enumext siga funcionando igual de bien después de cada cambio.
%
% Regresion:  l3build save test-001
%             l3build check test-001
%
% Test de regresion del entorno enumext y de enumext*: la estructura de las
% cajas (TEST), los contadores, las etiquetas y las referencias. El
% documento no usa \DocumentMetadata: aqui se comprueba que el paquete
% funciona sin etiquetado (el caso con etiquetado esta en test-010).
\input{regression-test}

\documentclass{article}
\ExplSyntaxOn
\debug_on:n { all }
\ExplSyntaxOff
\usepackage{enumext}
\begin{document}

% \BOXTEST compone el codigo en una caja y la muestra en el log: asi el
% .tlg guarda la estructura de la lista (glue, etiquetas, sangrias).
\newcommand\BOXTEST[2]
  {%
    \TEST{#1}
      {%
        \setbox0=\vbox{\hsize=250pt \parindent=0pt #2}%
        \showbox0
      }%
  }

\START

\TYPE{=== A. Etiquetas y numeracion ===}

% 1. Lista por defecto: tres items.
\BOXTEST{[1] lista por defecto}
  {
    \begin{enumext}
      \item Uno
      \item Dos
      \item Tres
    \end{enumext}
  }

% 2. Etiqueta con letras.
\BOXTEST{[2] label=\string\alph*)}
  {
    \begin{enumext}[label=\alph*)]
      \item Uno
      \item Dos
    \end{enumext}
  }

% 3. Etiqueta en romanos con envoltorio.
\BOXTEST{[3] label romano y wrap-label}
  {
    \begin{enumext}[label=\roman*., wrap-label=\textbf{#1}]
      \item Uno
      \item Dos
    \end{enumext}
  }

% 4. Primer numero.
\BOXTEST{[4] start=5}
  {
    \begin{enumext}[start=5]
      \item Uno
      \item Dos
    \end{enumext}
  }

% 5. Item con etiqueta propia y item sin etiqueta.
\BOXTEST{[5] \string\item[X] y \string\item*}
  {
    \begin{enumext}
      \item Uno
      \item[X] Dos
      \item* Tres
      \item Cuatro
    \end{enumext}
  }

\TYPE{=== B. Separaciones ===}

% 6. Ancho y separacion de la etiqueta.
\BOXTEST{[6] labelwidth y labelsep}
  {
    \begin{enumext}[labelwidth=1cm, labelsep=0.25cm, align=left]
      \item Uno
      \item Dos
    \end{enumext}
  }

% 7. Sin separacion entre items.
\BOXTEST{[7] nosep}
  {
    \begin{enumext}[nosep]
      \item Uno
      \item Dos
    \end{enumext}
  }

% 8. Espacio arriba y abajo.
\BOXTEST{[8] above y below}
  {
    \begin{enumext}[above=10pt, below=20pt]
      \item Uno
      \item Dos
    \end{enumext}
  }

\TYPE{=== C. Niveles ===}

% 9. Dos niveles anidados.
\BOXTEST{[9] dos niveles}
  {
    \begin{enumext}
      \item Uno
        \begin{enumext}
          \item Uno-uno
          \item Uno-dos
        \end{enumext}
      \item Dos
    \end{enumext}
  }

% 10. Tres niveles anidados.
\BOXTEST{[10] tres niveles}
  {
    \begin{enumext}
      \item Uno
        \begin{enumext}
          \item Uno-uno
            \begin{enumext}
              \item Uno-uno-uno
            \end{enumext}
        \end{enumext}
    \end{enumext}
  }

\TYPE{=== D. Contadores y referencias ===}

% 11. Contadores al terminar una lista y despues de otra.
\BOXTEST{[11] contadores}
  {
    \begin{enumext}
      \item Uno
      \item Dos
    \end{enumext}
    \TYPE{enumi=\the\value{enumi}}
    \begin{enumext}
      \item Uno
    \end{enumext}
    \TYPE{enumi=\the\value{enumi}}
  }

% 12. Series: continuar la numeracion.
\BOXTEST{[12] series y resume}
  {
    \begin{enumext}[series=uno]
      \item Uno
      \item Dos
    \end{enumext}
    Texto entre listas.
    \begin{enumext}[resume=uno]
      \item Tres
    \end{enumext}
  }

\TYPE{=== E. enumext* ===}

% 13. Version con asterisco: lista corta.
\BOXTEST{[13] enumext*}
  {
    \begin{enumext*}[label=\alph*)]
      \item Uno
      \item Dos
      \item Tres
    \end{enumext*}
  }

\TYPE{=== F. item-break (items de fila completa) ===}

% \SPLITTEST compone el codigo en una caja, la parte con \vsplit a 40pt y
% muestra las dos piezas: con item-break el item de fila completa debe poder
% partirse; sin la clave el item es una caja y pasa entero a la pieza inferior.
\newcommand\SPLITTEST[2]
  {%
    \TEST{#1}
      {%
        \setbox0=\vbox{\hsize=250pt \parindent=0pt #2}%
        \setbox2=\vsplit0 to 40pt
        \TYPE{--- pieza superior ---}%
        \showbox2
        \TYPE{--- pieza inferior ---}%
        \showbox0
      }%
  }

% 14. Sin la clave: el item de fila completa no se parte.
\SPLITTEST{[14] item de fila completa sin item-break}
  {
    \begin{enumext*}[columns=2]
      \item Uno
      \item Dos
      \item(2) Fila completa con bastante texto para ocupar varias lineas de la
        caja: esta frase se repite para que el item no quepa en la pieza
        superior. Esta frase se repite para que el item no quepa en la pieza
        superior.
      \item Cuatro
    \end{enumext*}
  }

% 15. Con la clave: el mismo item se parte entre las dos piezas.
\SPLITTEST{[15] item de fila completa con item-break}
  {
    \begin{enumext*}[columns=2,item-break=true]
      \item Uno
      \item Dos
      \item(2) Fila completa con bastante texto para ocupar varias lineas de la
        caja: esta frase se repite para que el item no quepa en la pieza
        superior. Esta frase se repite para que el item no quepa en la pieza
        superior.
      \item Cuatro
    \end{enumext*}
  }

% 16. Con la clave, los items que no ocupan toda la fila siguen en caja.
\BOXTEST{[16] item-break sin items de fila completa}
  {
    \begin{enumext*}[columns=2,item-break=true]
      \item Uno
      \item Dos
      \item Tres
    \end{enumext*}
  }

% 17. Con la clave y columns=1 todos los items ocupan toda la fila.
\BOXTEST{[17] item-break con columns=1}
  {
    \begin{enumext*}[columns=1,label=\alph*),item-break=true]
      \item Uno
      \item Dos
    \end{enumext*}
  }

% 18. Item de fila completa con etiqueta propia, con item* y con dos parrafos.
\BOXTEST{[18] item-break con etiqueta propia, item* y dos parrafos}
  {
    \begin{enumext*}[columns=2,item-break=true]
      \item(2)[X] Etiqueta propia.
      \item(2)* Item con simbolo.

        Segundo parrafo del item.
      \item Normal
    \end{enumext*}
  }

% 19. item-break como valor por defecto y como valor explicito.
\BOXTEST{[19] item-break=false}
  {
    \begin{enumext*}[columns=2,item-break=false]
      \item(2) Fila completa en caja.
    \end{enumext*}
  }

\TYPE{=== G. item-break y claves de espacios horizontales ===}

% Cada clave se prueba por pares sobre la misma lista: primero con item-break
% (el item de fila completa no lleva minipage) y despues sin la clave (el item
% va en caja). En el .tlg las lineas del item de fila completa deben quedar con
% el mismo desplazamiento y el mismo ancho en las dos cajas: con item-break el
% desplazamiento viene de \parshape y el ancho del texto, de \linewidth.
\newcommand\KROWS
  {%
    \item Uno
    \item Dos
    \item(2) Fila completa con texto suficiente para ocupar dos lineas de la
      caja: esta frase se repite. Esta frase se repite para llenar la linea.

      Segundo parrafo del item de fila completa.
    \item Cuatro
  }
\newcommand\KEYPAIR[3]
  {%
    \BOXTEST{[#1] #2 con #3 (item-break)}
      {%
        \begin{#2}[columns=2,item-break=true,#3]
          \KROWS
        \end{#2}%
      }%
    \BOXTEST{[#1] #2 con #3 (caja)}
      {%
        \begin{#2}[columns=2,#3]
          \KROWS
        \end{#2}%
      }%
  }

\KEYPAIR{20}{enumext*}{list-offset=10pt}
\KEYPAIR{21}{enumext*}{list-offset=-10pt}
\KEYPAIR{22}{enumext*}{labelwidth=30pt,labelsep=10pt}
\KEYPAIR{23}{enumext*}{itemindent=15pt}
\KEYPAIR{24}{enumext*}{rightmargin=20pt}
\KEYPAIR{25}{enumext*}{listparindent=12pt}
\KEYPAIR{26}{enumext*}{align=right,labelwidth=25pt}
\KEYPAIR{27}{enumext*}
  {list-offset=10pt,labelwidth=30pt,labelsep=8pt,rightmargin=20pt,itemindent=15pt}

% keyans* solo existe dentro de enumext con save-ans, y necesita un item*.
\newcommand\KEYPAIRK[3]
  {%
    \BOXTEST{[#1] keyans* con #3 (item-break)}
      {%
        \begin{enumext}[save-ans=#2a]
          \item Pregunta.
            \begin{keyans*}[columns=2,item-break=true,#3]
              \item Uno
              \item Dos
              \item(2)* Fila completa con texto suficiente para ocupar dos
                lineas de la caja: esta frase se repite. Esta frase se repite
                para llenar la linea.

                Segundo parrafo del item de fila completa.
              \item Cuatro
            \end{keyans*}
        \end{enumext}%
      }%
    \BOXTEST{[#1] keyans* con #3 (caja)}
      {%
        \begin{enumext}[save-ans=#2b]
          \item Pregunta.
            \begin{keyans*}[columns=2,#3]
              \item Uno
              \item Dos
              \item(2)* Fila completa con texto suficiente para ocupar dos
                lineas de la caja: esta frase se repite. Esta frase se repite
                para llenar la linea.

                Segundo parrafo del item de fila completa.
              \item Cuatro
            \end{keyans*}
        \end{enumext}%
      }%
  }
\KEYPAIRK{28}{claveuno}
  {list-offset=10pt,labelwidth=30pt,labelsep=8pt,rightmargin=20pt,itemindent=15pt}

% 29. Alineaciones dentro del item de fila completa: \centering y
% \raggedright ponen \leftskip a cero, la sangria no debe perderse.
\BOXTEST{[29] \string\centering\space y \string\raggedright\space (item-break)}
  {
    \begin{enumext*}[columns=2,item-break=true,labelwidth=30pt,labelsep=10pt]
      \item(2) {\centering Texto centrado de la primera linea.\par}

        {\raggedright Texto alineado a la izquierda del segundo parrafo.\par}
    \end{enumext*}
  }
\BOXTEST{[29] \string\centering\space y \string\raggedright\space (caja)}
  {
    \begin{enumext*}[columns=2,labelwidth=30pt,labelsep=10pt]
      \item(2) {\centering Texto centrado de la primera linea.\par}

        {\raggedright Texto alineado a la izquierda del segundo parrafo.\par}
    \end{enumext*}
  }

\OMIT
\end{document}
