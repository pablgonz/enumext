    Antes\par
    \begin{enumext}[mini-env=3cm, partopsep=5pt]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[8] enumext con mini-env, topsep con estiramiento}
  {
    Antes\par
    \begin{enumext}[mini-env=3cm, topsep=12pt plus 2pt]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

