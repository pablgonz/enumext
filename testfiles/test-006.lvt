% test-006.lvt -- espacios verticales de minipage y multicols
%
% Hecho con cariño por Pablo González L. <pablgonz@educarchile.cl>
% para que enumext siga funcionando igual de bien después de cada cambio.
%
% Regresion:  l3build save test-006
%             l3build check test-006
%
% Test de regresion de los espacios verticales (arriba, abajo y alineacion de
% la linea base) de las llaves mini-env, mini-right, mini-right*, columns y del
% comando \miniright en enumext, keyans, enumext* y keyans*. Cada caso va
% precedido y seguido de texto, en modo vertical u horizontal, y compone el
% codigo en una caja que se muestra en el log (\BOXTEST). Se prueban los
% valores de topsep, itemsep, partopsep y nosep, y los niveles anidados. Los
% nombres de almacenamiento no se reutilizan. Las listas sin minipage ni
% columnas sirven de referencia para comparar.
\input{regression-test}

\documentclass{article}
\ExplSyntaxOn
\debug_on:n { all }
\ExplSyntaxOff
\usepackage{enumext}
\begin{document}

\newcommand\BOXTEST[2]
  {%
    \TEST{#1}
      {%
        \setbox0=\vbox{\hsize=250pt \linewidth=\hsize \columnwidth=\hsize \parindent=0pt #2}%
        \showbox0
      }%
  }

\START

\TYPE{=== A. enumext con mini-env: contexto y parametros ===}

\BOXTEST{[1] enumext con mini-env, despues de texto, modo vertical}
  {
    Antes\par
    \begin{enumext}[mini-env=3cm]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[2] enumext con mini-env, despues de texto, modo horizontal}
  {
    Antes
    \begin{enumext}[mini-env=3cm]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[3] enumext con mini-env, sin texto antes}
  {
    \begin{enumext}[mini-env=3cm]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[4] enumext con mini-env, topsep=0pt}
  {
    Antes\par
    \begin{enumext}[mini-env=3cm, topsep=0pt]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[5] enumext con mini-env, nosep}
  {
    Antes\par
    \begin{enumext}[mini-env=3cm, nosep]
      \item Uno
      \item Dos
      \item Tres
      \miniright
      Derecha
    \end{enumext}
    Despues
  }

\BOXTEST{[6] enumext con mini-env, topsep e itemsep}
  {
    Antes\par
